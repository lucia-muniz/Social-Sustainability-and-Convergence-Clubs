   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Modelos de clasificación de clubes de convergencia (datos 2023)\n",
    "\n",
    "\n",

   ],
   "id": "6e4445b8"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import warnings\n",
    "from itertools import product\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import sklearn\n",
    "from scipy.stats import skew\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.exceptions import ConvergenceWarning\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.metrics import (\n",
    "    accuracy_score,\n",
    "    balanced_accuracy_score,\n",
    "    classification_report,\n",
    "    confusion_matrix,\n",
    "    f1_score,\n",
    ")\n",
    "from sklearn.model_selection import (\n",
    "    GridSearchCV,\n",
    "    LeaveOneOut,\n",
    "    StratifiedKFold,\n",
    "    cross_val_predict,\n",
    ")\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "try:\n",
    "    from IPython.display import display\n",
    "except ImportError:  # por si se ejecuta fuera de Jupyter\n",
    "    display = print\n",
    "\n",
    "SEMILLA = 42\n",
    "N_JOBS = -1  # usa todos los núcleos; pon 1 si Windows da \"TerminatedWorkerError\"\n",
    "SK_NUEVO = tuple(int(v) for v in sklearn.__version__.split(\".\")[:2]) >= (1, 8)"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "a1ea3416"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Carga y preparación de datos"
   ],
   "id": "8aa8ab95"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "RUTAS = [\"todos los determinantes.xlsx\", \"todos_los_determinantes.xlsx\"]\n",
    "ruta = next((Path(r) for r in RUTAS if Path(r).exists()), None)\n",
    "if ruta is None:\n",
    "    raise FileNotFoundError(f\"No encuentro el Excel en {Path.cwd()}. Probé: {RUTAS}\")\n",
    "\n",
    "datos = pd.read_excel(ruta).drop(columns=[\"Unnamed: 2\"], errors=\"ignore\")\n",
    "\n",
    "# Columnas numéricas que vienen como texto (valores '..' o con coma decimal) -> número\n",
    "COLS_ID = [\"PAIS\", \"PAIS.1\", \"CLUB\", \"AÑO\"]\n",
    "for col in datos.columns.difference(COLS_ID):\n",
    "    datos[col] = pd.to_numeric(\n",
    "        datos[col].astype(str).str.replace(\",\", \".\", regex=False),\n",
    "        errors=\"coerce\",   # '..' y similares pasan a NaN\n",
    "    )\n",
    "\n",
    "# El club de cada país se toma del año 2000; las variables, del año 2023\n",
    "club_por_pais = (\n",
    "    datos.loc[datos[\"AÑO\"] == 2000, [\"PAIS.1\", \"CLUB\"]]\n",
    "    .drop_duplicates(\"PAIS.1\")\n",
    "    .set_index(\"PAIS.1\")[\"CLUB\"]\n",
    ")\n",
    "\n",
    "datos_2023 = (\n",
    "    datos.loc[datos[\"AÑO\"] == 2023]\n",
    "    .drop(columns=[\"PAIS\", \"CLUB\", \"AÑO\"])\n",
    "    .set_index(\"PAIS.1\")\n",
    ")\n",
    "datos_2023[\"CLUB\"] = datos_2023.index.map(club_por_pais)\n",
    "datos_2023 = datos_2023.dropna(subset=[\"CLUB\"])\n",
    "datos_2023[\"CLUB\"] = datos_2023[\"CLUB\"].astype(int)\n",
    "\n",
    "X = datos_2023.drop(columns=\"CLUB\")\n",
    "y = datos_2023[\"CLUB\"]          # entero (1, 2, 3), no categoría\n",
    "CLASES = np.sort(y.unique())\n",
    "\n",
    "print(f\"{X.shape[0]} países, {X.shape[1]} variables | NaN en X: {int(X.isna().sum().sum())}\")\n",
    "print(\"Distribución de clubes:\", y.value_counts().sort_index().to_dict())\n",
    "print(\"Tipos:\", X.dtypes.astype(str).unique().tolist())\n",
    "X.head()"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "1b3aa11a"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Resumen descriptivo"
   ],
   "id": "e9af5bde"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "resumen = X.describe().T\n",
    "resumen[\"rango\"] = resumen[\"max\"] - resumen[\"min\"]\n",
    "resumen[\"asimetria\"] = X.apply(lambda s: skew(s.dropna()))\n",
    "resumen[[\"min\", \"max\", \"rango\", \"mean\", \"std\", \"asimetria\"]].round(3)"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "898f690a"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Utilidades comunes\n",
    "\n",
    "- `evaluar` imprime y guarda las métricas de cada modelo.\n",
    "- `loocv_anidado` elige hiperparámetros con un CV de 5 folds **dentro** de cada fold del LOOCV, de modo que la métrica final no está inflada por haber optimizado sobre los mismos datos."
   ],
   "id": "06343c10"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "LOOCV = LeaveOneOut()\n",
    "CV_INTERNO = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEMILLA)\n",
    "resultados = {}\n",
    "\n",
    "\n",
    "def evaluar(nombre, y_pred, detalle=True):\n",
    "    resultados[nombre] = {\n",
    "        \"accuracy\": accuracy_score(y, y_pred),\n",
    "        \"balanced_accuracy\": balanced_accuracy_score(y, y_pred),\n",
    "        \"f1_macro\": f1_score(y, y_pred, average=\"macro\"),\n",
    "    }\n",
    "    print(f\"Accuracy {nombre}: {resultados[nombre]['accuracy']:.2%}\")\n",
    "    print(f\"Balanced accuracy {nombre}: {resultados[nombre]['balanced_accuracy']:.2%}\")\n",
    "    if detalle:\n",
    "        matriz = pd.DataFrame(\n",
    "            confusion_matrix(y, y_pred, labels=CLASES),\n",
    "            index=[f\"real_{c}\" for c in CLASES],\n",
    "            columns=[f\"pred_{c}\" for c in CLASES],\n",
    "        )\n",
    "        print(\"Matriz de confusión:\")\n",
    "        print(matriz)\n",
    "        print(classification_report(y, y_pred, zero_division=0))\n",
    "\n",
    "\n",
    "def preprocesamiento(escalar=True):\n",
    "    pasos = [(\"imputar\", SimpleImputer(strategy=\"median\"))]\n",
    "    if escalar:\n",
    "        pasos.append((\"escalar\", StandardScaler()))\n",
    "    return Pipeline(pasos)\n",
    "\n",
    "\n",
    "def logistica(tipo):\n",
    "    \"\"\"Regresión logística multinomial: 'lasso' (L1) o 'elasticnet'.\n",
    "    Compatible con scikit-learn < 1.8 (penalty) y >= 1.8 (l1_ratio).\"\"\"\n",
    "    base = dict(solver=\"saga\", max_iter=5000, tol=1e-3, random_state=SEMILLA)\n",
    "    if SK_NUEVO:\n",
    "        return LogisticRegression(l1_ratio={\"lasso\": 1.0, \"elasticnet\": 0.5}[tipo], **base)\n",
    "    if tipo == \"lasso\":\n",
    "        return LogisticRegression(penalty=\"l1\", **base)\n",
    "    return LogisticRegression(penalty=\"elasticnet\", l1_ratio=0.5, **base)\n",
    "\n",
    "\n",
    "def loocv_anidado(nombre, modelo, rejilla):\n",
    "    busqueda = GridSearchCV(\n",
    "        modelo, rejilla, cv=CV_INTERNO, scoring=\"balanced_accuracy\", n_jobs=1\n",
    "    )\n",
    "    with warnings.catch_warnings():\n",
    "        # Los C grandes no convergen con saga y simplemente puntúan mal en la búsqueda\n",
    "        warnings.simplefilter(\"ignore\", ConvergenceWarning)\n",
    "        y_pred = cross_val_predict(busqueda, X, y, cv=LOOCV, n_jobs=N_JOBS)\n",
    "        evaluar(nombre, y_pred)\n",
    "        # Ajuste final con todos los datos (para interpretar hiperparámetros/coeficientes)\n",
    "        busqueda.fit(X, y)\n",
    "    print(\"Hiperparámetros del ajuste final:\", busqueda.best_params_)\n",
    "    return busqueda"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "4c854d04"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Regresión logística (línea base)"
   ],
   "id": "a7a117dc"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "modelo_log = Pipeline([\n",
    "    (\"prep\", preprocesamiento()),\n",
    "    (\"clf\", LogisticRegression(max_iter=1000)),\n",
    "])\n",
    "y_pred_log = cross_val_predict(modelo_log, X, y, cv=LOOCV, n_jobs=N_JOBS)\n",
    "evaluar(\"Logística (L2)\", y_pred_log)"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "53582e0e"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Lasso (L1)"
   ],
   "id": "c652b649"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "modelo_lasso = Pipeline([(\"prep\", preprocesamiento()), (\"clf\", logistica(\"lasso\"))])\n",
    "rejilla_lasso = {\n",
    "    \"clf__C\": np.logspace(-2, 1, 7),\n",
    "    \"clf__class_weight\": [None, \"balanced\"],\n",
    "}\n",
    "busqueda_lasso = loocv_anidado(\"Lasso\", modelo_lasso, rejilla_lasso)"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "904dff52"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Variables seleccionadas por el Lasso (coeficiente != 0 en alguna clase)\n",
    "clf = busqueda_lasso.best_estimator_.named_steps[\"clf\"]\n",
    "coef = pd.DataFrame(\n",
    "    clf.coef_.T, index=X.columns, columns=[f\"coef_club_{c}\" for c in clf.classes_]\n",
    ")\n",
    "seleccionadas = coef[(coef.abs() > 1e-8).any(axis=1)]\n",
    "print(f\"Variables seleccionadas: {len(seleccionadas)} de {X.shape[1]}\")\n",
    "display(seleccionadas.round(3))"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "98cfeeeb"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Elastic Net"
   ],
   "id": "a87fe33e"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "modelo_en = Pipeline([\n",
    "    (\"prep\", preprocesamiento()),\n",
    "    (\"clf\", logistica(\"elasticnet\").set_params(class_weight=\"balanced\")),\n",
    "])\n",
    "rejilla_en = {\n",
    "    \"clf__C\": [0.01, 0.1, 1, 10],\n",
    "    \"clf__l1_ratio\": [0.2, 0.5, 0.8],\n",
    "}\n",
    "busqueda_en = loocv_anidado(\"Elastic Net\", modelo_en, rejilla_en)"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "f0074122"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Random Forest\n",
    "\n",
    "Los árboles no se ven afectados por la estandarización (solo por el orden de los valores), así que las dos versiones del notebook original (con y sin estandarizar) daban lo mismo; aquí queda una sola."
   ],
   "id": "0176ee76"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "def crear_rf(class_weight=\"balanced\", n_estimators=500, **kw):\n",
    "    return Pipeline([\n",
    "        (\"prep\", preprocesamiento(escalar=False)),\n",
    "        (\"clf\", RandomForestClassifier(\n",
    "            n_estimators=n_estimators, class_weight=class_weight,\n",
    "            random_state=SEMILLA, **kw,\n",
    "        )),\n",
    "    ])\n",
    "\n",
    "\n",
    "y_pred_rf = cross_val_predict(crear_rf(), X, y, cv=LOOCV, n_jobs=N_JOBS)\n",
    "evaluar(\"Random Forest\", y_pred_rf)\n",
    "\n",
    "rf_final = crear_rf(n_jobs=N_JOBS).fit(X, y)\n",
    "importancias = pd.Series(\n",
    "    rf_final.named_steps[\"clf\"].feature_importances_, index=X.columns\n",
    ").sort_values(ascending=False)\n",
    "print(\"Importancia de variables:\")\n",
    "print(importancias.round(3))"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "2fec2678"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Random Forest: pesos por clase y factores de decisión\n",
    "\n",
    "1. **Pesos por clase** (se aplican al entrenar). Para explorarlos rápido uso la estimación *out-of-bag* (OOB) del bosque: cada país se predice solo con los árboles que no lo vieron, algo muy parecido a LOOCV pero con **un único ajuste por combinación** en vez de 125.\n",
    "2. **Factores de decisión** (se aplican después, sobre las probabilidades): se multiplica la probabilidad de cada clase por un factor y se toma el máximo. Con la clase 1 fija en 1.\n",
    "3. Se confirma la configuración elegida con LOOCV real, y los factores se evalúan también de forma **anidada** (para cada país, se eligen con los otros 124)."
   ],
   "id": "50bd4662"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# --- 8.1 Pesos por clase mediante OOB ---------------------------------------\n",
    "X_imp = preprocesamiento(escalar=False).fit_transform(X)\n",
    "y_arr = y.to_numpy()\n",
    "y_idx = np.searchsorted(CLASES, y_arr)   # clases codificadas como 0..k-1\n",
    "\n",
    "\n",
    "def balanced_acc_oob(pesos, n_estimators=500):\n",
    "    rf = RandomForestClassifier(\n",
    "        n_estimators=n_estimators, class_weight=pesos, oob_score=True,\n",
    "        bootstrap=True, random_state=SEMILLA, n_jobs=N_JOBS,\n",
    "    ).fit(X_imp, y_arr)\n",
    "    proba = np.nan_to_num(rf.oob_decision_function_)   # NaN si ningún árbol lo dejó fuera\n",
    "    return balanced_accuracy_score(y_arr, rf.classes_[proba.argmax(1)])\n",
    "\n",
    "\n",
    "valores_peso = [0.5, 1, 1.5, 2, 3]\n",
    "busqueda_pesos = pd.DataFrame(\n",
    "    [(w2, w3, balanced_acc_oob({1: 1.0, 2: w2, 3: w3}))\n",
    "     for w2, w3 in product(valores_peso, valores_peso)],\n",
    "    columns=[\"peso_2\", \"peso_3\", \"balanced_acc_oob\"],\n",
    ").sort_values(\"balanced_acc_oob\", ascending=False)\n",
    "\n",
    "print(\"Referencia class_weight='balanced' (OOB):\", round(balanced_acc_oob(\"balanced\"), 4))\n",
    "display(busqueda_pesos.head(5).round(4))"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "6863fc57"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# --- 8.2 Confirmación con LOOCV real y probabilidades -------------------------\n",
    "mejor = busqueda_pesos.iloc[0]\n",
    "PESOS = {1: 1.0, 2: float(mejor.peso_2), 3: float(mejor.peso_3)}\n",
    "print(\"Pesos elegidos:\", PESOS)\n",
    "\n",
    "# cross_val_predict(method=\"predict_proba\") recodifica y a 0..k-1 internamente\n",
    "# (de ahí el error \"The classes, [0], are not in class_weight\" del original),\n",
    "# así que le paso y ya codificado y los pesos indexados por posición de clase.\n",
    "PESOS_IDX = {i: PESOS[c] for i, c in enumerate(CLASES)}\n",
    "proba_rf = cross_val_predict(\n",
    "    crear_rf(class_weight=PESOS_IDX), X, y_idx, cv=LOOCV, n_jobs=N_JOBS, method=\"predict_proba\"\n",
    ")\n",
    "evaluar(\"RF + pesos\", CLASES[proba_rf.argmax(1)])"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "5e0b8785"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# --- 8.3 Factores de decisión sobre las probabilidades (vectorizado) ----------\n",
    "Y1 = np.eye(len(CLASES))[y_idx]            # one-hot de la clase real\n",
    "valores_f = np.round(np.geomspace(0.5, 2.5, 21), 3)\n",
    "F = np.array([[1.0, f2, f3] for f2, f3 in product(valores_f, valores_f)])   # (G, 3)\n",
    "penal = 1e-6 * np.abs(np.log(F)).sum(1)    # desempate: prefiere factores cercanos a 1\n",
    "\n",
    "pred_idx = np.argmax(proba_rf[None, :, :] * F[:, None, :], axis=2)          # (G, n)\n",
    "acierto = (pred_idx == y_idx[None, :]).astype(float)                         # (G, n)\n",
    "hits = acierto @ Y1                                                          # (G, k)\n",
    "cuentas = Y1.sum(0)\n",
    "\n",
    "# Factores óptimos sobre todos los datos (optimista: mismo conjunto para elegir y evaluar)\n",
    "ba_g = (hits / cuentas).mean(1)\n",
    "g_opt = int(np.argmax(ba_g - penal))\n",
    "print(\"Factores óptimos:\", F[g_opt], \"| balanced accuracy (optimista):\", round(ba_g[g_opt], 4))\n",
    "\n",
    "# Evaluación anidada: para cada país, los factores se eligen con los otros n-1\n",
    "pred_anidado = np.empty(len(y_arr), dtype=int)\n",
    "for i in range(len(y_arr)):\n",
    "    hits_i = hits - acierto[:, [i]] * Y1[i]\n",
    "    ba_i = (hits_i / (cuentas - Y1[i])).mean(1)\n",
    "    pred_anidado[i] = pred_idx[np.argmax(ba_i - penal), i]\n",
    "\n",
    "print()\n",
    "evaluar(\"RF + pesos + factores (anidado)\", CLASES[pred_anidado])"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "899fd0de"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. Comparación de modelos (LOOCV)"
   ],
   "id": "2b750edf"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "tabla = pd.DataFrame(resultados).T.sort_values(\"balanced_accuracy\", ascending=False)\n",
    "display((tabla * 100).round(2).rename(columns=lambda c: c + \" (%)\"))"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "16025d84"
  }
